# Contoh konfigurasi secrets untuk dashboard harga bawang putih.
#
# KREDENSIAL TIDAK ADA DI DALAM KODE. Aplikasi wajib punya secrets ini,
# baik di lokal maupun di Streamlit Cloud.
#
# CARA PAKAI
# ----------
# Lokal:
#   Copy-Item .streamlit\secrets.toml.example .streamlit\secrets.toml
#   lalu isi password aslinya. File secrets.toml sudah masuk .gitignore.
#
# Streamlit Cloud:
#   Buka app -> Settings -> Secrets, lalu tempel isi file ini
#   dengan nilai yang sudah diganti. Jangan mengandalkan file ini di repo.

[auth.users.admin]
password = "ganti-dengan-password-admin"
role = "admin"

[auth.users.user]
password = "ganti-dengan-password-user"
role = "user"
